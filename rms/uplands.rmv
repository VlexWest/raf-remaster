ResourceToEdgeDistance          kResourceToEdgeDistance
ResourceToWaterDistance         kResourceToWaterDistance

ResourcePerPlayer               (Animal,    kAnimalPerPlayer)
ResourcePerNeutralLand          (Animal,    kAnimalPerNeutral)

