// land/water attributes
PercentLand                     kPercentLand
LandElevationThreshold          0
WaterBorder                     kWaterBorder
RiverWidth                      kRiverWidth
TeamGrowth                      false

RiverLandFill                   true
PeninsulaKiller                 kPeninsulaKiller
RiverLandFillWidth              kRiverLandFillWidth

CoastalToDeeperWaterPercentage  kCoastToDeepWaterPercentage
ShallowsElevation               kShallowsElevation
ShallowsWidth                   kShallowsWidth
MaxShallowConnectionsPerPlayer  kMaxShallowConnectionsPerPlayer
TileDistanceBetweenShallows     kTileDistanceBetweenShallows
