 * Bone weights per bone slot. The last used slot takes 1 - sum(previous), as in
 * stock. Shadow-map and reflected objects use two bones whatever the mesh has.
 */
float4
RafBoneWeights(float4 inBlendWeights)
{
	float4 theWeights = float4(inBlendWeights.x, 0.0F, 0.0F, 0.0F);
@@ keep 2 94bd7ef9
