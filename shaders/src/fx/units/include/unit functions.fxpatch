@@ keep 4 0ef83e67
@@ drop 4 bd8618ba
 * RafLightCube: same result as ComputeCubeLighting, written without dynamic
 * constant indexing so it is cheap in a pixel shader.
 */
float3
RafAmbientLighting(float3 inWorldNormal)
{
#if k_UseLightCube

	float3 theSquared = inWorldNormal * inWorldNormal;
	float3 theX = (inWorldNormal.x < 0.0F) ? k_LightingRegion[1].rgb : k_LightingRegion[0].rgb;
	float3 theY = (inWorldNormal.y < 0.0F) ? k_LightingRegion[3].rgb : k_LightingRegion[2].rgb;
	float3 theZ = (inWorldNormal.z < 0.0F) ? k_LightingRegion[5].rgb : k_LightingRegion[4].rgb;
	return theSquared.x * theX + theSquared.y * theY + theSquared.z * theZ;

#else

	return ComputeStandardLighting(k_LightDirection, inWorldNormal, k_AmbientColor, k_LightColor);

#endif
}


