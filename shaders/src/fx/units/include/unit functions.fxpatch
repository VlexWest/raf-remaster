#endif

/* Skinned position only (shared by every vertex shader). */
float3
RafSkinPosition(float3 inPosition, float4 inBlendWeights, float4 inBlendIndices)
{
	float4	theWeights = RafBoneWeights(inBlendWeights);
	int4	theIndices = D3DCOLORtoUBYTE4(inBlendIndices);
	float4	thePosition = float4(inPosition, 1.0F);

	float3 theResult = mul(thePosition, k_BoneMatrices[theIndices.x]) * theWeights.x;
#if (RAF_BONE_COUNT >= 2)
	theResult += mul(thePosition, k_BoneMatrices[theIndices.y]) * theWeights.y;
#endif
#if (RAF_BONE_COUNT >= 3)
	theResult += mul(thePosition, k_BoneMatrices[theIndices.z]) * theWeights.z;
#endif
#if (RAF_BONE_COUNT >= 4)
	theResult += mul(thePosition, k_BoneMatrices[theIndices.w]) * theWeights.w;
#endif
	return theResult;
}

/* Skinned direction (normal, tangent, binormal): rotation part only, not normalised. */
float3
RafSkinVector(float3 inVector, float4 inBlendWeights, float4 inBlendIndices)
{
	float4	theWeights = RafBoneWeights(inBlendWeights);
	int4	theIndices = D3DCOLORtoUBYTE4(inBlendIndices);

	float3 theResult = mul(inVector, (float3x3) k_BoneMatrices[theIndices.x]) * theWeights.x;
#if (RAF_BONE_COUNT >= 2)
	theResult += mul(inVector, (float3x3) k_BoneMatrices[theIndices.y]) * theWeights.y;
#endif
#if (RAF_BONE_COUNT >= 3)
	theResult += mul(inVector, (float3x3) k_BoneMatrices[theIndices.z]) * theWeights.z;
#endif
#if (RAF_BONE_COUNT >= 4)
	theResult += mul(inVector, (float3x3) k_BoneMatrices[theIndices.w]) * theWeights.w;
#endif
