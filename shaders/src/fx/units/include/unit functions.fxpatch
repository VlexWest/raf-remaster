	float3 theResult;
	theResult.x = (inPosition.x > k_AxisCap.x) ? theCapped.x : inPosition.x;
	theResult.y = (inPosition.y < k_AxisCap.y) ? theCapped.y : inPosition.y;
	theResult.z = (inPosition.z > k_AxisCap.z) ? theCapped.z : inPosition.z;
