/*
 * RafSurface: per-pixel normal and its lighting for the pixel shaders.
 */
struct RAF_SURFACE
{
	float3	mNormal;		/* normalised world normal */
	float	mSpecMask;		/* stock-compatible specular amount */
	float3	mLight;			/* ambient / light-cube colour at the normal (gamma space) */
};

RAF_SURFACE
RafComputeSurface(in VS_OUTPUT inVertex, float4 inTexture)
{
	RAF_SURFACE theSurface;
	theSurface.mSpecMask = RAF_UNIT_SPEC_DEFAULT;
